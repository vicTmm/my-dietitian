  "narrative": {
    "northStar": "Club member editorial",
    "overview": "Base combinesthe navy, yellow and white requested by the user with the familiarity of a personal planning application. The identity feels calm and assured: a substantial navy navigation rail, clear white work surfaces, compact lists and warm yellow moments of recognition. Gaming affinity appears through ranks and earned progress, while the controls remain familiar web controls.\n\nExpression comes from color, Manrope's rounded letterforms and restrained membership details. Food photography is illustrative and served locally. This system describes the implemented MVP, rather than an independent visual proposal.",
    "keyCharacteristics": [
      "Navy anchors the shell and primary actions.",
      "Yellow marks selected moments and earned progress.",
      "White work surfaces use fine borders rather than ambient shadows.",
      "Dense information uses aligned rows and consistent units."
    ],
    "rules": [
      {
        "name": "The Navy Anchor Rule",
        "body": "Navigation and major actions share navy; color changes communicate state rather than a separate visual theme for each page.",
        "section": "colors"
      },
      {
        "name": "The One Family Rule",
        "body": "Use Manrope weight and scale to establish hierarchy; preserve a single voice across planning, habits and progress.",
        "section": "typography"
      },
      {
        "name": "The Flat Work Surface Rule",
        "body": "Persistent planning surfaces use borders or tonal separation; reserve shadows for temporary overlays.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the navy, yellow and white brand commitment.",
      "Do keep standard web navigation, checkboxes, buttons and forms recognizable.",
      "Do align numeric values with their units and label planned nutrition clearly.",
      "Do preserve visible keyboard focus and reduced-motion support."
    ],
    "donts": [
      "Don't replace the club palette with a generic gradient theme.",
      "Don't use decorative glyphs in place of the Lucide icon system.",
      "Don't turn a row-based planning task into a grid of interchangeable promotional cards."
    ]
  }
